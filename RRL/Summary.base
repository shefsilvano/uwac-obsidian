views:
  - type: table
    name: View
    filters:
      and:
        - file.folder == "RRL/RRL Summary"
    groupBy:
      property: Category
      direction: ASC
    order:
      - file.name
      - Summary
      - Author/s
      - Title
      - Year
      - Category
      - Publication
    sort:
      - property: Author/s
        direction: ASC
      - property: Year
        direction: DESC
      - property: Title
        direction: DESC
    columnSize:
      note.Summary: 403
      note.Author/s: 76
      note.Title: 383
      note.Year: 63
      note.Category: 255
      note.Publication: 75
